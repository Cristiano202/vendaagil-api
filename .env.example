# Copie este arquivo para .env e preencha (o .env NAO deve ser commitado).
# Evite $, aspas e espacos nas senhas. Para o Mongo, evite tambem @ : / ? # (entram na URL de conexao).

# ---------- PostgreSQL ----------
POSTGRES_DB=vendaagil_db
POSTGRES_USER=troque_o_usuario
POSTGRES_PASSWORD=troque_a_senha

# ---------- Redis ----------
REDIS_PASSWORD=troque_a_senha_do_redis

# ---------- MongoDB ----------
MONGO_DB=vendaagil_mongo
MONGO_USER=troque_o_usuario_mongo
MONGO_PASSWORD=troque_a_senha_do_mongo

# ---------- pgAdmin ----------
PGADMIN_DEFAULT_EMAIL=voce@exemplo.com
PGADMIN_DEFAULT_PASSWORD=troque_a_senha_do_pgadmin
# Fixe uma versao do pgAdmin para builds reproduziveis (ex.: 9.9)
PGADMIN_TAG=latest

# ---------- JWT ----------
# Gere com: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=troque_por_uma_chave_aleatoria_longa
# Tempo de vida do token em ms (3600000 = 1 hora)
JWT_EXPIRATION_MS=3600000